# CGCP Production Integration - ENV TEMPLATE (NOT_PROVISIONED)
# Copy to .env in your target environment and fill real values. Do NOT commit secrets.

# App
NODE_ENV=production
PORT=8787
CGCP_API_KEY_FILE=/run/secrets/cgcp_api_key
CGCP_STORE_MODE=postgres
DATABASE_URL=postgres://USER:PASSWORD@postgres-primary:5432/cgcp?sslmode=require
DATABASE_READ_URL=postgres://USER:PASSWORD@postgres-replica:5432/cgcp?sslmode=require

# Tenancy/Auth (integration required)
AUTH_MODE=oidc
OIDC_ISSUER=https://idp.example.com/
OIDC_AUDIENCE=cgcp-control-plane
OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
SCIM_ENABLED=false

# KMS / Anchoring (integration required)
KMS_PROVIDER=aws-kms # aws-kms|gcp-kms|azure-keyvault|vault|local-dev-only
KMS_KEY_ID=
ANCHOR_PROVIDER=http-witness # http-witness|transparency-log|local-dev-only
ANCHOR_ENDPOINT=
ANCHOR_HMAC_KEY_FILE=/run/secrets/cgcp_anchor_hmac

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=cgcp-control-plane
SLO_TARGET_AVAILABILITY=0.999

# ---------------------------------------------------------------------------
# CG-INT/1 real integration adapters. Every value below is a PLACEHOLDER.
# Replace with real endpoints and secret FILE PATHS in the target environment.
# Nothing here is considered PROVISIONED until config.mjs says so.
# ---------------------------------------------------------------------------

# Real x402 / settlement verifier (no custody, no signing, no broadcast)
CG_X402_VERIFIER_ENDPOINT=https://settlement-verifier.REPLACE.invalid
CG_X402_API_KEY_FILE=/run/secrets/cgcp_x402_api_key
CG_X402_NETWORK=stellar
CG_X402_ASSET=USDC
CG_X402_MIN_CONFIRMATIONS=1
CG_X402_VERIFIER_PUBLIC_KEY_FILE=/run/secrets/cgcp_x402_verifier_pub.pem

# Real OIDC IdP
CG_OIDC_ISSUER=https://idp.REPLACE.invalid/
CG_OIDC_AUDIENCE=cgcp-control-plane
CG_OIDC_JWKS_URL=https://idp.REPLACE.invalid/.well-known/jwks.json
CG_OIDC_TENANT_CLAIM=tenant_id
CG_OIDC_REQUIRE_TENANT=true

# Real SCIM 2.0 lifecycle
CG_SCIM_BASE_URL=https://scim.REPLACE.invalid
CG_SCIM_TOKEN_FILE=/run/secrets/cgcp_scim_token
CG_SCIM_PROBE_TENANT=
CG_SCIM_PROBE_FILTER=

# Real KMS / HSM (aws-kms|gcp-kms|azure-keyvault|vault|pkcs11)
CG_KMS_PROVIDER=aws-kms
CG_KMS_KEY_ID=REPLACE_WITH_REAL_KEY_ID
CG_KMS_REGION=eu-central-1
CG_KMS_ACCESS_KEY_ID_FILE=/run/secrets/aws_access_key_id
CG_KMS_SECRET_ACCESS_KEY_FILE=/run/secrets/aws_secret_access_key
CG_KMS_SESSION_TOKEN_FILE=
CG_KMS_TOKEN_FILE=
CG_KMS_VAULT=
CG_KMS_KEY=
CG_KMS_ADDR=

# Real external witness / transparency log
CG_WITNESS_ENDPOINT=https://witness.REPLACE.invalid
CG_WITNESS_PUBLIC_KEY_FILE=/run/secrets/cgcp_witness_pub.pem

# Real read-only Stellar Horizon anchor check
STELLAR_HORIZON_URL=https://horizon.REPLACE.invalid
STELLAR_NETWORK_PASSPHRASE=REPLACE_WITH_REAL_NETWORK_PASSPHRASE

# Real OTLP / alerting (OTEL_EXPORTER_OTLP_ENDPOINT + OTEL_SERVICE_NAME are above; replace the reference values)
CG_ALERT_WEBHOOK_URL=https://alerts.REPLACE.invalid/hook
CG_ALERT_TOKEN_FILE=/run/secrets/cgcp_alert_token
